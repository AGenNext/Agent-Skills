{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agnext.dev/schemas/skills/theory-of-mind.schema.json",
  "title": "TheoryOfMindSkillState",
  "type": "object",
  "required": [
    "actor_id",
    "actor_type",
    "beliefs",
    "knowledge",
    "intentions",
    "uncertainties",
    "confidence"
  ],
  "properties": {
    "actor_id": { "type": "string" },
    "actor_type": {
      "type": "string",
      "enum": ["human", "agent", "organization", "team", "system"]
    },
    "beliefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "predicate", "object", "confidence"],
        "properties": {
          "subject": { "type": "string" },
          "predicate": { "type": "string" },
          "object": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "is_stale": { "type": "boolean", "default": false }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "known": { "type": "array", "items": { "type": "string" } },
        "unknown": { "type": "array", "items": { "type": "string" } },
        "needed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intent", "confidence"],
        "properties": {
          "intent": { "type": "string" },
          "business_outcome": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "trust": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "basis": { "type": "array", "items": { "type": "string" } }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "recommended_action": { "type": "string", "enum": ["proceed", "clarify", "retrieve", "escalate", "stop"] }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
