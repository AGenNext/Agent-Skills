{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "AGenNext Skill DB Record",
  "description": "Database-shaped skill_source_v1 record contract. Context is intentionally excluded from this import/export schema.",
  "type": "object",
  "required": [
    "type",
    "skill_id",
    "name",
    "version",
    "lifecycle_status",
    "category",
    "risk",
    "runtime_profiles",
    "required_tools",
    "approval_required",
    "inputs",
    "outputs",
    "graph_context_owner",
    "semantic_class",
    "graph_ownership",
    "does_not_define_graph_schema"
  ],
  "properties": {
    "type": { "enum": ["ag:Skill", "Skill"] },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "schema_version": { "type": "string" },
    "lifecycle_status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved", "published", "deprecated"]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "description": { "type": "string" },
    "creator": {},
    "publisher": {},
    "runtime_profiles": { "type": "array", "items": { "type": "string" } },
    "required_tools": { "type": "array", "items": { "type": "string" } },
    "required_secrets": { "type": "array", "items": { "type": "string" } },
    "approval_required": { "type": "boolean", "default": false },
    "inputs": { "type": "object", "additionalProperties": true },
    "outputs": { "type": "object", "additionalProperties": true },
    "graph_context_owner": { "const": "Agent-Graph" },
    "semantic_class": { "const": "CreativeWork" },
    "graph_ownership": { "const": "Agent-Graph" },
    "does_not_define_graph_schema": { "const": true },
    "published_structured_data_context": { "type": "string" },
    "source_repository": { "type": "string" },
    "source_path": { "type": "string" },
    "source_format": { "enum": ["yaml", "json", "markdown", "html", "text"] },
    "source_commit_sha": { "type": "string" },
    "source_hash": { "type": "string" },
    "date_created": { "type": "string", "format": "date-time" },
    "date_modified": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
